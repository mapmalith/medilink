generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  HOTEL
  AGENT
  TOUR_GUIDE
  ADMIN
  CALL_CENTER
}

enum AppointmentType {
  HOUSE_CALL
  TELE_CONSULTATION
  MEDICAL_VISIT
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CREDIT_USED
}

enum PaymentMethod {
  PAYMENT_LINK
  CREDIT_LIMIT
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient  Patient?
  doctor   Doctor?
  hotel    Hotel?
  staff    Staff?

  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

model Patient {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  dateOfBirth     DateTime? @map("date_of_birth")
  nationality     String?
  passportNumber  String?  @map("passport_number")
  whatsappNumber  String?  @map("whatsapp_number")
  emailAddress    String?  @map("email_address")
  hotelId         String?  @map("hotel_id")
  isAnonymized    Boolean  @default(false) @map("is_anonymized")
  anonymizedAt    DateTime? @map("anonymized_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel          Hotel?          @relation(fields: [hotelId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  consents       PatientConsent[]

  @@index([hotelId])
  @@map("patients")
}

model Doctor {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  firstName                String   @map("first_name")
  lastName                 String   @map("last_name")
  specialization           String?
  licenseNumber            String   @unique @map("license_number")
  whatsappNumber           String?  @map("whatsapp_number")
  isAvailableHouseCall     Boolean  @default(false) @map("is_available_house_call")
  isAvailableTeleConsult   Boolean  @default(false) @map("is_available_tele_consult")
  isAvailableMedicalVisit  Boolean  @default(false) @map("is_available_medical_visit")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability   DoctorAvailability[]
  timeSlots      TimeSlot[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@map("doctors")
}

model Hotel {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  name          String
  address       String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  latitude      Float?
  longitude     Float?
  creditLimit   Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditUsed    Decimal  @default(0) @map("credit_used") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients      Patient[]
  qrCodes       QRCode[]
  appointments  Appointment[]
  creditLedger  CreditLedger[]

  @@map("hotels")
}

model Staff {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  department String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("staff")
}

model QRCode {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  code      String   @unique
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  scanCount Int      @default(0) @map("scan_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("qr_codes")
}

model AppointmentPricing {
  id              String          @id @default(uuid())
  appointmentType AppointmentType @map("appointment_type")
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  isActive        Boolean         @default(true) @map("is_active")
  effectiveFrom   DateTime        @map("effective_from")
  effectiveTo     DateTime?       @map("effective_to")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([appointmentType, isActive])
  @@map("appointment_pricing")
}

model DoctorAvailability {
  id              String          @id @default(uuid())
  doctorId        String          @map("doctor_id")
  dayOfWeek       Int             @map("day_of_week")
  startTime       String          @map("start_time")
  endTime         String          @map("end_time")
  appointmentType AppointmentType @map("appointment_type")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, appointmentType])
  @@map("doctor_availability")
}

model TimeSlot {
  id              String          @id @default(uuid())
  doctorId        String          @map("doctor_id")
  date            DateTime        @db.Date
  startTime       DateTime        @map("start_time")
  endTime         DateTime        @map("end_time")
  appointmentType AppointmentType @map("appointment_type")
  isBooked        Boolean         @default(false) @map("is_booked")
  appointmentId   String?         @unique @map("appointment_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([doctorId, date, isBooked])
  @@index([appointmentType, date, isBooked])
  @@map("time_slots")
}

model Appointment {
  id                String            @id @default(uuid())
  appointmentType   AppointmentType   @map("appointment_type")
  status            AppointmentStatus @default(PENDING_PAYMENT)
  patientId         String            @map("patient_id")
  doctorId          String?           @map("doctor_id")
  hotelId           String?           @map("hotel_id")
  createdByStaffId  String?           @map("created_by_staff_id")
  bookedBy          Role              @map("booked_by")
  scheduledDate     DateTime          @map("scheduled_date") @db.Date
  scheduledTime     DateTime          @map("scheduled_time")
  duration          Int               @default(30)
  visitAddress      String?           @map("visit_address")
  visitLatitude     Float?            @map("visit_latitude")
  visitLongitude    Float?            @map("visit_longitude")
  videoRoomUrl      String?           @map("video_room_url")
  videoRoomId       String?           @map("video_room_id")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  paymentMethod     PaymentMethod?    @map("payment_method")
  paymentLinkUrl    String?           @map("payment_link_url")
  paymentLinkExpiry DateTime?         @map("payment_link_expiry")
  amountCharged     Decimal?          @map("amount_charged") @db.Decimal(12, 2)
  currency          String            @default("USD")
  notes             String?
  cancellationReason String?          @map("cancellation_reason")
  isRescheduled     Boolean           @default(false) @map("is_rescheduled")
  rescheduledFromId String?           @map("rescheduled_from_id")
  rescheduleCount   Int               @default(0) @map("reschedule_count")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  patient         Patient         @relation(fields: [patientId], references: [id])
  doctor          Doctor?         @relation(fields: [doctorId], references: [id])
  hotel           Hotel?          @relation(fields: [hotelId], references: [id])
  createdByStaff  Staff?          @relation(fields: [createdByStaffId], references: [id])
  rescheduledFrom Appointment?    @relation("RescheduleChain", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment[]   @relation("RescheduleChain")
  timeSlot        TimeSlot?
  medicalRecord   MedicalRecord?
  rescheduleLogs  RescheduleLog[]
  payments        Payment[]
  invoice         Invoice?
  creditLedger    CreditLedger[]

  @@index([status])
  @@index([scheduledDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([hotelId])
  @@index([createdByStaffId])
  @@index([rescheduledFromId])
  @@map("appointments")
}

model RescheduleLog {
  id                  String   @id @default(uuid())
  appointmentId       String   @map("appointment_id")
  previousDate        DateTime @map("previous_date") @db.Date
  previousTime        DateTime @map("previous_time")
  previousDoctorId    String?  @map("previous_doctor_id")
  newDate             DateTime @map("new_date") @db.Date
  newTime             DateTime @map("new_time")
  newDoctorId         String?  @map("new_doctor_id")
  reason              String
  rescheduledByUserId String   @map("rescheduled_by_user_id")
  rescheduledByRole   Role     @map("rescheduled_by_role")
  createdAt           DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("reschedule_logs")
}

model MedicalRecord {
  id               String    @id @default(uuid())
  appointmentId    String    @unique @map("appointment_id")
  patientId        String    @map("patient_id")
  doctorId         String    @map("doctor_id")
  diagnosis        String?
  notes            String?
  followUpRequired Boolean   @default(false) @map("follow_up_required")
  followUpDate     DateTime? @map("follow_up_date")
  followUpNotes    String?   @map("follow_up_notes")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  documents     MedicalDocument[]

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

model Prescription {
  id              String  @id @default(uuid())
  medicalRecordId String  @map("medical_record_id")
  drugId          String  @map("drug_id")
  dosage          String
  frequency       String
  duration        String
  instructions    String?
  createdAt       DateTime @default(now()) @map("created_at")

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  drug          Drug          @relation(fields: [drugId], references: [id])

  @@index([medicalRecordId])
  @@index([drugId])
  @@map("prescriptions")
}

model Drug {
  id           String  @id @default(uuid())
  name         String
  genericName  String? @map("generic_name")
  category     String?
  manufacturer String?
  dosageForm   String? @map("dosage_form")
  strength     String?
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  prescriptions Prescription[]

  @@map("drugs")
}

model MedicalDocument {
  id              String @id @default(uuid())
  medicalRecordId String @map("medical_record_id")
  fileName        String @map("file_name")
  fileType        String @map("file_type")
  s3Key           String @map("s3_key")
  fileSize        Int    @map("file_size")
  createdAt       DateTime @default(now()) @map("created_at")

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
  @@map("medical_documents")
}

model Payment {
  id              String        @id @default(uuid())
  appointmentId   String        @map("appointment_id")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique @map("stripe_payment_id")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("payments")
}

model CreditLedger {
  id            String   @id @default(uuid())
  hotelId       String   @map("hotel_id")
  amount        Decimal  @db.Decimal(12, 2)
  type          String
  description   String
  appointmentId String?  @map("appointment_id")
  balance       Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([hotelId])
  @@index([appointmentId])
  @@map("credit_ledger")
}

model Invoice {
  id               String   @id @default(uuid())
  appointmentId    String   @unique @map("appointment_id")
  invoiceNumber    String   @unique @map("invoice_number")
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD")
  pdfS3Key         String?  @map("pdf_s3_key")
  sentViaWhatsApp  Boolean  @default(false) @map("sent_via_whatsapp")
  sentViaEmail     Boolean  @default(false) @map("sent_via_email")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model PatientConsent {
  id           String    @id @default(uuid())
  patientId    String    @map("patient_id")
  consentType  String    @map("consent_type")
  consentText  String    @map("consent_text")
  givenAt      DateTime  @default(now()) @map("given_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  isWithdrawn  Boolean   @default(false) @map("is_withdrawn")
  withdrawnAt  DateTime? @map("withdrawn_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, consentType])
  @@map("patient_consents")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── WHATSAPP ───────────────────────────────────────────────────────────────

enum WhatsAppConversationState {
  IDLE
  AWAITING_NAME
  AWAITING_TYPE
  AWAITING_DATE
  AWAITING_TIME_SLOT
  AWAITING_CONFIRMATION
}

model WhatsAppConversation {
  id        String                    @id @default(uuid())
  phone     String                    @unique
  state     WhatsAppConversationState @default(IDLE)
  stateData Json?                     @map("state_data")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  @@map("whatsapp_conversations")
}

model WhatsAppLog {
  id            String   @id @default(uuid())
  direction     String   // "in" or "out"
  phone         String
  body          String
  state         String?
  messageSid    String?  @map("message_sid")
  appointmentId String?  @map("appointment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([createdAt])
  @@index([appointmentId])
  @@map("whatsapp_logs")
}
