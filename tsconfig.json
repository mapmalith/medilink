{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@medilink/shared-types": ["packages/shared-types/src/index.ts"],
      "@medilink/validation": ["packages/validation/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
